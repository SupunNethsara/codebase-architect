# ==========================================================
# Codebase Architect - Production Environment Configuration
# ==========================================================

# Port Configuration
# Port 80 is reserved for your other project (enterprise-rag-engine).
# Codebase Architect runs on Port 3000:
FRONTEND_PORT=3000

# PostgreSQL Credentials
POSTGRES_DB=codebase_architect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretDatabasePassword123!

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
