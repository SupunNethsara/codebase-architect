# ==========================================================
# Codebase Architect - Production Environment Configuration
# ==========================================================

# Port Configuration
# Port 3000 is used by enterprise-rag-engine frontend.
# Codebase Architect uses Port 80 (standard HTTP) or Port 8081:
FRONTEND_PORT=80

# PostgreSQL Credentials (Internal to Docker, does not conflict with host 5432)
POSTGRES_DB=codebase_architect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretDatabasePassword123!

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
